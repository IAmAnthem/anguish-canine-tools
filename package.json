{
  "name": "anguish-canine-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check": "npm run typecheck && npm test",
    "check:data": "vitest run tests/dataIntegrity.test.ts",
    "apply:canine-draft": "node scripts/apply-canine-draft.mjs",
    "apply:status-patch": "node scripts/apply-status-patch.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
